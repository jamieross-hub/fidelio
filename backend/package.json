        "@types/pg": "^8.15.6",
        "firebase-tools": "^13.5.0",
        "prisma": "^7.1.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "@types/cors": "^2.8.17",
        "@types/jsonwebtoken": "^9.0.7"
    },
