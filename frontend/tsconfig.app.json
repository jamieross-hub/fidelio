{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": [
        "env.d.ts",
        "components.d.ts",
        "src/**/*",
        "../backend/api-contract/**/*",
        "../backend/prisma/generated/zod/schemas/variants/**/*"
    ],
    "exclude": ["src/**/__tests__/*"],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@api-contract": ["../backend/api-contract"],
            "@api-contract/*": ["../backend/api-contract/*"],
            "@schemas/*": ["../backend/prisma/generated/zod/schemas/variants/*"],
            "@/*": ["./src/*"]
        },
        "types": ["node"]
    }
}
