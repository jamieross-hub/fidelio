{
    "name": "backend",
    "version": "1.0.0",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && npx prisma generate && npx tsc && tsc-alias",
        "start": "npx prisma migrate deploy && node dist/src/server.js",
        "dev": "npx tsx watch src/server.ts",
        "firebase": "cd .firebase && npx firebase emulators:start --import=./data --export-on-exit",
        "email-tester": "npx tsx watch --env-file=.env src/emails/_tests/test.ts"
    },
